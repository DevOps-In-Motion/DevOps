{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EnsureAndPushUatTempRepo",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:us-west-2:YOUR_AWS_ACCOUNT_ID:repository/uat-temp",
        "arn:aws:ecr:us-west-2:YOUR_AWS_ACCOUNT_ID:repository/rascaas",
        "arn:aws:ecr:us-west-2:YOUR_AWS_ACCOUNT_ID:repository/rascaas-uat-ecr-cleanup"
      ]
    }
  ]
}
