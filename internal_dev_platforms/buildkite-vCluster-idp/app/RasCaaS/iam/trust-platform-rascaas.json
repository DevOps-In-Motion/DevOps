{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEksRascaasServiceAccounts",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:oidc-provider/oidc.eks.us-west-2.amazonaws.com/id/YOUR_EKS_OIDC_PROVIDER_ID"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.eks.us-west-2.amazonaws.com/id/YOUR_EKS_OIDC_PROVIDER_ID:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "oidc.eks.us-west-2.amazonaws.com/id/YOUR_EKS_OIDC_PROVIDER_ID:sub": [
            "system:serviceaccount:rascaas:rascaas-sa",
            "system:serviceaccount:rascaas:oauth2proxy-sa"
          ]
        }
      }
    }
  ]
}
