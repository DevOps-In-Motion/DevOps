{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEksServiceAccount",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::650251729525:oidc-provider/oidc.eks.us-west-2.amazonaws.com/id/OIDC_PROVIDER_ID"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.eks.us-west-2.amazonaws.com/id/OIDC_PROVIDER_ID:aud": "sts.amazonaws.com",
          "oidc.eks.us-west-2.amazonaws.com/id/OIDC_PROVIDER_ID:sub": "system:serviceaccount:rascaas:rascaas-uat-temp-ecr-cleanup"
        }
      }
    }
  ]
}
