{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthAndDescribeRepo",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:DescribeRepositories"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CleanupUatTempImages",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:BatchDeleteImage"
      ],
      "Resource": "arn:aws:ecr:us-west-2:YOUR_AWS_ACCOUNT_ID:repository/uat-temp"
    }
  ]
}
