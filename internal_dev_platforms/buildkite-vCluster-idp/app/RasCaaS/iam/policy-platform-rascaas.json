{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRascaasSecretsManagerSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-west-2:YOUR_AWS_ACCOUNT_ID:secret:rascaas-secrets*"
    }
  ]
}
